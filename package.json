    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "dotenv": "^18.0.10",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
