{
  "name": "wage-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Wage evidence confirm-or-dispute registry on ME Network testnet (hackathon prototype).",
  "license": "MIT",
  "scripts": {
    "wallet": "node scripts/wallet.mjs",
    "check": "node scripts/check-endpoints.mjs",
    "meid": "node scripts/meid.mjs",
    "hash": "node scripts/hash-report.mjs",
    "test": "npx hardhat test",
    "compile": "npx hardhat compile",
    "chain": "npx hardhat node",
    "deploy:local": "npx hardhat run scripts/deploy.cjs --network localhost",
    "deploy:testnet": "npx hardhat run scripts/deploy.cjs --network metestnet",
    "memo": "node scripts/memo-tx.mjs",
    "web": "node scripts/serve-web.mjs"
  },
  "devDependencies": {
    "@cosmjs/amino": "^0.39.0",
